# Copy to .env (in the directory you run mb from) and adjust if needed. All
# keys have working defaults in macos_backup/cli.py; .env only needs to carry
# overrides. Never commit a real .env (see .gitignore).
# $VAR and ~ are expanded for path-like keys (BACKUP_ROOT, EXCLUDE_FILE,
# MANIFEST_DIR, LOG_FILE, DOCK_PLIST_PATH, FDA_PROBE_PATH); a relative
# EXCLUDE_FILE resolves against the current directory, not mb's install
# location. DOTENV_FILE overrides where .env itself is read from.

RESTIC_REPOSITORY=sftp:syn:/shares/Mac/Backup

# Password: set ONE of these two, not both.
#   RESTIC_PASSWORD          - the password itself, read directly (e.g. from a
#                               password manager's env injection). Never put a
#                               literal password in a committed file.
#   RESTIC_PASSWORD_COMMAND  - a shell command that prints the password (the
#                               default below reads it from the login keychain).
# If RESTIC_PASSWORD is set, RESTIC_PASSWORD_COMMAND is ignored.
RESTIC_PASSWORD=
RESTIC_PASSWORD_COMMAND=security find-generic-password -a restic -s restic-my-mac -w

SFTP_COMMAND=ssh -T -o RequestTTY=no syn -s sftp
RESTIC_BIN=restic
BACKUP_ROOT=$HOME
EXCLUDE_FILE=./excludes.txt
MANIFEST_DIR=$HOME/.local/state/macos_backup/manifest
LOG_FILE=$HOME/Library/Logs/macos_backup.log
RESTIC_COMPRESSION=fastest
BACKUP_TAG=scheduled
BACKUP_HOST=my-mac
EXCLUDE_IF_PRESENT=.nobackup
CHECK_READ_DATA_SUBSET=5%
DOCK_PLIST_PATH=$HOME/Library/Preferences/com.apple.dock.plist
FDA_PROBE_PATH=$HOME/Library/Mail
LAUNCHD_LABEL=com.pythoninthegrass.restic-backup
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
PRUNE_WEEKDAY=6
# Seconds to wait before each retry of a mid-backup connection loss (exit code 1, presumed network drop since preflight already proved ssh reachability). Exhausting the list re-raises as fatal.
BACKUP_RETRY_DELAYS=30,120,300
